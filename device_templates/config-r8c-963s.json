{
  "device_type": "R8C-963S",
  "title": "r8c_963s_template_title",
  "group": "g-thermostat",
  "device": {
    "name": "R8C-963S",
    "id": "R8C-963S",
    "response_timeout_ms": 100,
    "guard_interval_us": 5000,
    "groups": [
      { "title": "g_sensors", "id": "g_sensors", "order": 0 },
      { "title": "g_controls", "id": "g_controls", "order": 1 },
      { "title": "g_status", "id": "g_status", "order": 2 }
    ],
    "channels": [
      {
        "name": "state_cooling_valve",
        "id": "Cool valve",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:0:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_heating_valve",
        "id": "Heat valve",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:1:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_floor_heating_valve",
        "id": "Floor heating valve",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:2:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "di_dry_contact",
        "id": "Dry contact",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:3:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_fan_high",
        "id": "High-speed fan",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:4:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_fan_medium",
        "id": "Mid-speed fan",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:5:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_fan_low",
        "id": "Low-speed fan",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:6:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_x1",
        "id": "x1",
        "type": "switch",
        "reg_type": "holding",
        "address": "2:7:1",
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "state_wifi",
        "id": "Wi-Fi connection status",
        "type": "value",
        "reg_type": "holding",
        "address": 3,
        "readonly": true,
        "group": "g_status",
        "enum": [0, 1, 2, 3],
        "enum_titles": [
          "state_wifi_enum_0",
          "state_wifi_enum_1",
          "state_wifi_enum_2",
          "state_wifi_enum_3"
        ]
      },
      {
        "name": "setpoint_t_step",
        "id": "Temperature adjustment step",
        "type": "value",
        "reg_type": "holding",
        "units": "deg C",
        "address": 4,
        "readonly": true,
        "group": "g_controls",
        "scale": 0.1
      },
      {
        "name": "t_room",
        "id": "Room Temperature",
        "type": "value",
        "reg_type": "holding",
        "units": "deg C",
        "address": 5,
        "format": "s16",
        "readonly": true,
        "scale": 0.1,
        "group": "g_sensors"
      },
      {
        "name": "t_floor",
        "id": "Floor Temperature",
        "type": "value",
        "reg_type": "holding",
        "units": "deg C",
        "address": 6,
        "format": "s16",
        "readonly": true,
        "scale": 0.1,
        "group": "g_sensors",
        "enabled": false,
        "error_value": 9100
      },
      {
        "name": "di_room_card",
        "id": "Room card",
        "type": "switch",
        "reg_type": "holding",
        "address": 7,
        "readonly": true,
        "group": "g_status"
      },
      {
        "name": "setpoint_t_room",
        "id": "Temperature Setpoint",
        "type": "value",
        "reg_type": "holding",
        "units": "deg C",
        "address": 12,
        "format": "u16",
        "scale": 0.1,
        "round_to": 0.5,
        "min": 15,
        "max": 30,
        "step": 0.5,
        "group": "g_controls"
      },
      {
        "name": "state_power",
        "id": "Power",
        "type": "switch",
        "reg_type": "holding",
        "address": 13,
        "group": "g_controls"
      },
      {
        "name": "state_mode",
        "id": "Mode",
        "type": "value",
        "reg_type": "holding",
        "address": "15:0:8",
        "readonly": true,
        "format": "u8",
        "group": "g_status",
        "enum": [0, 1, 2, 3, 4],
        "enum_titles": [
          "state_mode_enum_0",
          "state_mode_enum_1",
          "state_mode_enum_2",
          "state_mode_enum_3",
          "state_mode_enum_4"
        ]
      },
      {
        "name": "speed_fan",
        "id": "Fan speed",
        "type": "value",
        "reg_type": "holding",
        "address": 16,
        "format": "u16",
        "group": "g_controls",
        "enum": [0, 1, 2, 3],
        "enum_titles": [
          "speed_fan_enum_0",
          "speed_fan_enum_1",
          "speed_fan_enum_2",
          "speed_fan_enum_3"
        ]
      },
      {
        "name": "state_control_mode",
        "id": "Control mode",
        "type": "value",
        "reg_type": "holding",
        "address": 17,
        "readonly": true,
        "format": "u16",
        "group": "g_status",
        "enum": [0, 1, 2],
        "enum_titles": [
          "state_control_mode_enum_0",
          "state_control_mode_enum_1",
          "state_control_mode_enum_2"
        ]
      },
      {
        "name": "state_lock",
        "id": "Lock status",
        "type": "value",
        "reg_type": "holding",
        "address": 18,
        "format": "u16",
        "group": "g_controls",
        "enum": [0, 1, 2],
        "enum_titles": [
          "state_lock_enum_0",
          "state_lock_enum_1",
          "state_lock_enum_2"
        ]
      },
      {
        "name": "state_floor_heating_mode",
        "id": "Mode switch (floor heating only)",
        "type": "value",
        "reg_type": "holding",
        "address": 19,
        "format": "u16",
        "group": "g_controls",
        "enum": [0, 1],
        "enum_titles": [
          "state_floor_heating_mode_enum_0",
          "state_floor_heating_mode_enum_1"
        ]
      },
      {
        "name": "humidity_indoor",
        "id": "Humidity indoor",
        "type": "value",
        "reg_type": "holding",
        "units": "%",
        "address": "22:0:8",
        "readonly": true,
        "format": "u8",
        "group": "g_sensors"
      },
      {
        "name": "humidity_outdoor",
        "id": "Humidity outdoor",
        "type": "value",
        "reg_type": "holding",
        "units": "%",
        "address": "0x0016:8:8",
        "readonly": true,
        "format": "u16",
        "group": "g_sensors"
      }
    ],
    "parameters": [
      {
        "id": "min_setting_temperature",
        "title": "min_setting_temperature",
        "reg_type": "holding",
        "units": "deg C",
        "address": 10,
        "format": "u16",
        "scale": 0.1,
        "round_to": 1,
        "min": 5,
        "max": 95,
        "default": 5,
        "group": "g_controls"
      },
      {
        "id": "max_setting_temperature",
        "title": "max_setting_temperature",
        "reg_type": "holding",
        "units": "deg C",
        "address": 9,
        "format": "u16",
        "scale": 0.1,
        "round_to": 1,
        "min": 5,
        "max": 95,
        "default": 50,
        "group": "g_controls"
      },
      {
        "id": "unit",
        "order": 1,
        "title": "unit",
        "address": 11,
        "reg_type": "holding",
        "format": "u16",
        "enum": [0, 1],
        "enum_titles": [
          "unit_enum_0",
          "unit_enum_1"
        ],
        "default": 0,
        "group": "g_controls"
      },
      {
        "id": "frost_protection",
        "title": "frost_protection",
        "reg_type": "holding",
        "address": 14,
        "format": "u16",
        "enum": [0, 1],
        "enum_titles": [
          "frost_protection_enum_0",
          "frost_protection_enum_1"
        ],
        "default": 1,
        "group": "g_controls"
      },
      {
        "id": "weekly_programming_mode",
        "title": "weekly_programming_mode",
        "reg_type": "holding",
        "address": 20,
        "format": "u16",
        "enum": [0, 1, 2],
        "enum_titles": [
          "weekly_programming_mode_enum_0",
          "weekly_programming_mode_enum_1",
          "weekly_programming_mode_enum_2"
        ],
        "default": 0,
        "group": "g_controls"
      }
    ],
